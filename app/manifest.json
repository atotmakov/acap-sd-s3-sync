{
    "schemaVersion": "2.2.0",
    "resources": {
        "linux": {
            "user": {
                "groups": ["storage"]
            }
        }
    },
    "acapPackageConf": {
        "setup": {
            "appName": "sds3sync",
            "friendlyName": "SD to S3 Sync",
            "vendor": "atotmakov.dev@gmail.com",
            "vendorId": "7e44c44f45",
            "vendorUrl": "https://github.com/atotmakov/acap-sd-s3-sync",
            "runMode": "respawn",
            "version": "0.9.5",
            "compatibleOsVersions": [
                { "min": "12.0", "max": "13" }
            ]
        },
        "configuration": {
            "paramConfig": [
                { "name": "S3Endpoint",    "default": "",                               "type": "string" },
                { "name": "S3Bucket",      "default": "cctv",                           "type": "string" },
                { "name": "S3Region",      "default": "us-east-1",                      "type": "string" },
                { "name": "S3AccessKey",   "default": "",                               "type": "string" },
                { "name": "S3SecretKey",   "default": "",                               "type": "string" },
                { "name": "S3PathStyle",   "default": "yes",                            "type": "string" },
                { "name": "S3InsecureTLS", "default": "no",                             "type": "string" },
                { "name": "Prefix",        "default": "",                               "type": "string" },
                { "name": "RecordingPath", "default": "/var/spool/storage/SD_DISK",     "type": "string" },
                { "name": "IntervalSeconds", "default": "60",                           "type": "string" },
                { "name": "HeartbeatIntervalSeconds", "default": "300",                 "type": "string" }
            ]
        }
    }
}
